# NeuraVision — environment template
# Copy to .env (git-ignored) and fill in real values. Two locations read env vars:
#   1) process environment / $_ENV   (preferred on a real server: nginx/php-fpm env or export in the shell)
#   2) a plain key=value file at api/.env  (fallback reader in api/nv_notify.php -> nv_api_env())
# Every key below is optional: the matching feature stays dormant / returns a soft error if unset.
# The SQLite databases under data/ are created automatically on first request — no schema import needed.

# ---- AI generation (the /account web generator: photo, video, image->video, video->video) ----
# Backed by an external generation API; photo is synchronous, video goes through an async
# queue that is polled to completion. Companion tooling uses its own provider keys.
VENICE_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Email (verification codes, welcome mail, trial codes) via Resend ----
RESEND_API_KEY=

# ---- SMS / phone verification ----
# Name of the SMS backend used by functions/sms_provider.php
SMS_PROVIDER=

# ---- OAuth login ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# ---- Pinterest Conversions API (optional) ----
# Not an env var: copy data/pinterest_capi.php.example -> data/pinterest_capi.php (git-ignored)
# and fill in ad_account_id/token. functions/pinterest_capi.php no-ops if that file is absent.

# ---- Anti-bot ----
# hCaptcha secret used by functions/captcha.php (access*.php / index.php download gate)
HCAPTCHA_SECRET=

# ---- Telegram notifications (new registrations, leads, support, partner applications) ----
TG_BOT_TOKEN=
TG_CHAT_ID=
PARTNERS_TG_TOKEN=
PARTNERS_TG_CHAT=
# Demo / "say hello" lead forms post to their own bot+group when set,
# otherwise they fall back to TG_BOT_TOKEN / TG_CHAT_ID above.
DEMO_TG_TOKEN=
DEMO_TG_CHAT=

# ---- Analytics tracker ----
# Salt used to hash visitor IPs before storage (a/collect.php, includes/track_actions.php)
LXTRACK_IP_SALT=

# ---- i18n ----
# Override the directory the translation dictionaries are loaded from (defaults to includes/nv_i18n)
NV_I18N_DICT_DIR=

# ---- Firebase phone auth (optional override) ----
# NOTE: Firebase *web* API keys are public by design (they ship in client page source);
# this only overrides the hardcoded fallback in functions/phone_verify.php.
FIREBASE_API_KEY=
